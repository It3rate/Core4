@page "/"

<PageTitle>Core4 Numeric Explorer</PageTitle>

<div class="home-page">
    <section class="topbar">
        <div class="topbar__intro">
            <p class="topbar__eyebrow">Core4 Display</p>
            <h1>Numeric Explorer</h1>
            <p class="topbar__text">
                Measure, inversion, freezing, and orthogonal tension in one compact view.
            </p>
        </div>

        <div class="topbar__stats">
            @if (IsPrimitiveBasisScene)
            {
                <span>mode primitive basis gallery</span>
                <span>segment @PrimitiveSnapshot.SegmentLabel</span>
                <span>self @PrimitiveSnapshot.SelfLabel · area @PrimitiveSnapshot.AreaLabel</span>
            }
            else
            {
                <span>mode @Snapshot.ResolutionMode</span>
                <span>reading @Snapshot.ComplexReading</span>
                <span>settled @Snapshot.Settlement.Settled.Normalize()</span>
            }
        </div>
    </section>

    <section class="preset-strip">
        @foreach (var preset in _presets)
        {
            <button class="preset-chip @(preset.Name == _selected.Name ? "is-active" : string.Empty)"
                    title="@preset.Description"
                    @onclick="() => LoadPreset(preset)">
                @preset.Name
            </button>
        }
    </section>

    <section class="main-grid">
        <aside class="control-panel">
            <div class="panel-heading">
                <p class="panel-heading__eyebrow">Active Preset</p>
                <h2>@_selected.Name</h2>
                <p>@_selected.Description</p>
            </div>

            <div class="control-stack">
                @if (IsPrimitiveBasisScene)
                {
                    <div class="primitive-panel-note">
                        Drag the two directed-segment endpoints. The other primitive bases reuse those same Core4 values.
                    </div>
                }
                else if (_selected.Controls.ShowFusedSpan)
                {
                    <MeasureSlider Label="Fused Span"
                                   Caption="The aligned pair stays equal while fused."
                                   Tone="var(--tone-dominant)"
                                   Min="1"
                                   Max="24"
                                   Value="@_dominantSpan"
                                   HollowThumb="true"
                                   ValueChanged="OnFusedSpanChanged" />
                }

                @if (_selected.Controls.ShowDominantSpan)
                {
                    <MeasureSlider Label="Dominant Span"
                                   Caption="Visible dominant reach."
                                   Tone="var(--tone-dominant)"
                                   Min="1"
                                   Max="24"
                                   Value="@_dominantSpan"
                                   HollowThumb="true"
                                   ValueChanged="value => _dominantSpan = Math.Max(1, value)" />
                }

                @if (_selected.Controls.ShowRecessiveSpan)
                {
                    <MeasureSlider Label="Recessive Span"
                                   Caption="Visible recessive reach."
                                   Tone="var(--tone-recessive)"
                                   Min="0"
                                   Max="24"
                                   Value="@_recessiveSpan"
                                   HollowThumb="true"
                                   ValueChanged="value => _recessiveSpan = Math.Max(0, value)" />
                }

                @if (_selected.Controls.ShowSingleValue)
                {
                    <MeasureSlider Label="Value Offset"
                                   Caption="Live reading from the origin."
                                   Tone="var(--tone-dominant)"
                                   Min="@_selected.Controls.SingleValueMin.Raw"
                                   Max="@_selected.Controls.SingleValueMax.Raw"
                                   Value="@_singleValueOffset"
                                    ValueChanged="value => _singleValueOffset = value" />
                }

                @if (_selected.Controls.ShowDominantValue)
                {
                    <MeasureSlider Label="Dominant Value"
                                   Caption="Independent value on the dominant unit."
                                   Tone="var(--tone-dominant)"
                                   Min="@_selected.Controls.PairValueMin.Raw"
                                   Max="@_selected.Controls.PairValueMax.Raw"
                                   Value="@_dominantValueOffset"
                                   ValueChanged="value => _dominantValueOffset = ClampPairOffset(value)" />
                }

                @if (_selected.Controls.ShowRecessiveValue)
                {
                    <MeasureSlider Label="Recessive Value"
                                   Caption="Independent value on the recessive unit."
                                   Tone="var(--tone-recessive)"
                                   Min="@_selected.Controls.PairValueMin.Raw"
                                   Max="@_selected.Controls.PairValueMax.Raw"
                                   Value="@_recessiveValueOffset"
                                   ValueChanged="value => _recessiveValueOffset = ClampPairOffset(value)" />
                }

                @if (_selected.Controls.ShowResidual)
                {
                    <MeasureSlider Label="Residual"
                                   Caption="Orthogonal remainder around the site."
                                   Tone="var(--tone-tension)"
                                   Min="0"
                                   Max="16"
                                   Value="@_residual"
                                   ValueChanged="value => _residual = Math.Max(0, value)" />
                }

                @if (_selected.Controls.ShowTopSignal)
                {
                    <MeasureSlider Label="Top Output"
                                   Caption="Dominant orthogonal publication."
                                   Tone="var(--tone-orthogonal)"
                                   Min="0"
                                   Max="16"
                                   Value="@_topSignal"
                                   HollowThumb="true"
                                   ValueChanged="value => _topSignal = Math.Max(0, value)" />
                }

                @if (_selected.Controls.ShowBottomSignal)
                {
                    <MeasureSlider Label="Bottom Input"
                                   Caption="Recessive orthogonal pressure."
                                   Tone="var(--tone-orthogonal-soft)"
                                   Min="0"
                                   Max="16"
                                   Value="@_bottomSignal"
                                   HollowThumb="true"
                                   ValueChanged="value => _bottomSignal = Math.Max(0, value)" />
                }

                @if (_selected.Controls.ShowBottomSignal2)
                {
                    <MeasureSlider Label="Bottom Input B"
                                   Caption="A second recessive orthogonal input."
                                   Tone="var(--tone-shared)"
                                   Min="0"
                                   Max="16"
                                   Value="@_bottomSignal2"
                                   HollowThumb="true"
                                   ValueChanged="value => _bottomSignal2 = Math.Max(0, value)" />
                }
            </div>
        </aside>

        <section class="scene-panel">
            <div class="scene-panel__header">
                <div>
                    <p class="scene-panel__eyebrow">Interactive Scene</p>
                    <h2>@SceneTitle</h2>
                    <p class="scene-panel__text">@SceneDescription</p>
                </div>

                <div class="scene-panel__summary">
                    @if (IsPrimitiveBasisScene)
                    {
                        <span>segment @PrimitiveSnapshot.SegmentLabel</span>
                        <span>self @PrimitiveSnapshot.SelfLabel</span>
                        <span>complex @PrimitiveSnapshot.ComplexLabel</span>
                    }
                    else
                    {
                        <span>@Snapshot.ComplexReading</span>
                        <span>origin @Snapshot.Origin.Raw</span>
                        <span>settled @Snapshot.Settlement.Settled.Normalize()</span>
                    }
                </div>
            </div>

            @if (IsPrimitiveBasisScene)
            {
                <PrimitiveBasisScene Snapshot="PrimitiveSnapshot"
                                     DominantChanged="value => _dominantValueOffset = ClampPrimitiveAlignedValue(value)"
                                     RecessiveChanged="value => _recessiveValueOffset = ClampPrimitiveAlignedValue(value)" />
            }
            else
            {
                <NumericLineScene Snapshot="Snapshot"
                                  OriginChanged="value => _origin = value"
                                  DominantSpanChanged="value => _dominantSpan = Math.Max(1, value)"
                                  RecessiveSpanChanged="value => _recessiveSpan = Math.Max(0, value)"
                                  SingleValueOffsetChanged="value => _singleValueOffset = value"
                                  DominantValueOffsetChanged="value => _dominantValueOffset = ClampPairOffset(value)"
                                  RecessiveValueOffsetChanged="value => _recessiveValueOffset = ClampPairOffset(value)"
                                  TopSignalChanged="value => _topSignal = Math.Max(0, value)"
                                  BottomSignalChanged="value => _bottomSignal = Math.Max(0, value)"
                                  BottomSignal2Changed="value => _bottomSignal2 = Math.Max(0, value)" />

                <section class="info-grid">
                    <article class="info-card">
                        <p class="info-card__eyebrow">Freeze Ladder</p>
                        <dl>
                            <div><dt>Origin</dt><dd>@Snapshot.Origin.Raw</dd></div>
                            <div><dt>Dominant</dt><dd>@Snapshot.Origin.Raw -> @Snapshot.DominantAnchor.Raw</dd></div>
                            <div><dt>Recessive</dt><dd>@(Snapshot.HasInverse ? $"{Snapshot.Origin.Raw} -> {Snapshot.RecessiveAnchor.Raw}" : "not present")</dd></div>
                            <div><dt>Structure</dt><dd>@BasisLabel</dd></div>
                        </dl>
                    </article>

                    <article class="info-card">
                        <p class="info-card__eyebrow">Reading</p>
                        <dl>
                            <div><dt>Complex</dt><dd>@Snapshot.ComplexReading</dd></div>
                            <div><dt>Dominant</dt><dd>@Snapshot.DominantReading.Normalize()</dd></div>
                            <div><dt>Recessive</dt><dd>@(Snapshot.HasInverse ? Snapshot.RecessiveReading.Normalize() : "unavailable")</dd></div>
                            <div><dt>Mode</dt><dd>@Snapshot.ResolutionMode</dd></div>
                        </dl>
                    </article>

                    <article class="info-card">
                        <p class="info-card__eyebrow">Orthogonal Frontier</p>
                        <dl>
                            <div><dt>Residual</dt><dd>@Snapshot.SourceSite.Orthogonal.Residual.Normalize()</dd></div>
                            <div><dt>Incoming</dt><dd>@Snapshot.SourceSite.Orthogonal.Incoming().Normalize()</dd></div>
                            <div><dt>Outgoing</dt><dd>@Snapshot.SourceSite.Orthogonal.Outgoing().Normalize()</dd></div>
                            <div><dt>Connections</dt><dd>@Snapshot.SourceSite.Orthogonal.ConnectionCount.Raw</dd></div>
                        </dl>
                        @if (Snapshot.Channels.Any(channel => channel.Value.Potential != Measure.Zero || channel.Value.Dominant != Measure.Zero))
                        {
                            <ul class="channel-list">
                                @foreach (var channel in Snapshot.Channels.Where(channel => channel.Value.Potential != Measure.Zero || channel.Value.Dominant != Measure.Zero))
                                {
                                    <li>
                                        <strong>@channel.Name</strong>
                                        <span>@channel.Value.Normalize()</span>
                                        <span>prov @channel.Provenance.Axis.Normalize()</span>
                                    </li>
                                }
                            </ul>
                        }
                    </article>

                    <article class="info-card">
                        <p class="info-card__eyebrow">Settlement Trace</p>
                        <ol class="term-list">
                            @foreach (var term in Snapshot.Settlement.Terms)
                            {
                                <li>
                                    <span>@term.Order.Raw</span>
                                    <strong>@term.Phase</strong>
                                    <code>@term.Value.Normalize()</code>
                                </li>
                            }
                        </ol>
                    </article>
                </section>
            }
        </section>
    </section>
</div>

@code {
    private readonly ImmutableArray<NumericExplorerPreset> _presets = NumericExplorerExamples.Presets();

    private NumericExplorerPreset _selected;
    private long _origin;
    private long _dominantSpan;
    private long _recessiveSpan;
    private long _singleValueOffset;
    private long _dominantValueOffset;
    private long _recessiveValueOffset;
    private long _residual;
    private long _topSignal;
    private long _bottomSignal;
    private long _bottomSignal2;

    private NumericExplorerSnapshot Snapshot => NumericExplorerExamples.Build(CurrentPreset);

    private PrimitiveBasisSnapshot PrimitiveSnapshot => PrimitiveBasisExamples.Build(CurrentPreset);

    private bool IsPrimitiveBasisScene => _selected.Name == PrimitiveBasisExamples.PresetName;

    private string SceneTitle => IsPrimitiveBasisScene
        ? "Six Primitive Fusions"
        : Snapshot.ResolutionMode;

    private string SceneDescription => _selected.Description;

    private string BasisLabel => !Snapshot.HasInverse
        ? "single dominant interval"
        : _selected.FuseAligned
            ? "fused directed segment"
            : "unfused inverted pair";

    private NumericExplorerPreset CurrentPreset => _selected with
    {
        Origin = new Measure(_origin),
        DominantSpan = new Measure(_dominantSpan),
        RecessiveSpan = new Measure(_recessiveSpan),
        SingleValueOffset = new Measure(_singleValueOffset),
        DominantValueOffset = new Measure(_dominantValueOffset),
        RecessiveValueOffset = new Measure(_recessiveValueOffset),
        Residual = new Measure(_residual),
        TopSignal = new Measure(_topSignal),
        BottomSignal = new Measure(_bottomSignal),
        BottomSignal2 = new Measure(_bottomSignal2)
    };

    protected override void OnInitialized() => LoadPreset(_presets[0]);

    private void LoadPreset(NumericExplorerPreset preset)
    {
        _selected = preset;
        _origin = preset.Origin.Raw;
        _dominantSpan = preset.DominantSpan.Raw;
        _recessiveSpan = preset.RecessiveSpan.Raw;
        _singleValueOffset = preset.SingleValueOffset.Raw;
        _dominantValueOffset = preset.DominantValueOffset.Raw;
        _recessiveValueOffset = preset.RecessiveValueOffset.Raw;
        _residual = preset.Residual.Raw;
        _topSignal = preset.TopSignal.Raw;
        _bottomSignal = preset.BottomSignal.Raw;
        _bottomSignal2 = preset.BottomSignal2.Raw;
    }

    private void OnFusedSpanChanged(long value)
    {
        var clamped = Math.Max(1, value);
        _dominantSpan = clamped;
        _recessiveSpan = clamped;
    }

    private long ClampPairOffset(long value) => _selected.FuseAligned ? value : Math.Max(0, value);

    private static long ClampPrimitiveAlignedValue(long value) => Math.Clamp(value, -24L, 24L);

}

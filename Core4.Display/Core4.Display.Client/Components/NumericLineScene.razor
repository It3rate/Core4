@using Core4.Examples
@using Core4.Numerics

<div class="scene-wrap">
    <svg class="numeric-scene"
         viewBox="0 0 820 248"
         role="img"
         aria-label="Core4 numeric explorer scene"
         @onpointermove="OnPointerMove"
         @onpointerup="EndDrag"
         @onpointerleave="EndDrag">
        <defs>
            <marker id="arrowOrthogonal" markerUnits="userSpaceOnUse" viewBox="0 0 16 16" refX="13.2" refY="8" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M0 0 L16 8 L0 16 L4.9 8 Z" fill="var(--tone-orthogonal)" />
                <path d="M2.7 3.2 L11.6 8 L2.7 12.8 L5.7 8 Z" fill="white" />
            </marker>
            <marker id="arrowShared" markerUnits="userSpaceOnUse" viewBox="0 0 16 16" refX="13.2" refY="8" markerWidth="16" markerHeight="16" orient="auto">
                <path d="M0 0 L16 8 L0 16 L4.9 8 Z" fill="var(--tone-shared)" />
                <path d="M2.7 3.2 L11.6 8 L2.7 12.8 L5.7 8 Z" fill="white" />
            </marker>
        </defs>

        <rect x="0" y="0" width="820" height="248" rx="20" class="scene-surface" />

        @if (Snapshot.IsHiddenOnHalfLine)
        {
            <rect x="72" y="50" width="@(OriginX - 72)" height="150" class="scene-hidden" rx="16">
                <title>inverse side unrevealed</title>
            </rect>
        }

        <line x1="72" x2="748" y1="@AxisY" y2="@AxisY" class="scene-axis" />

        @foreach (var tick in AxisTicks())
        {
            <line x1="@tick.X" x2="@tick.X" y1="@(AxisY - tick.Height)" y2="@(AxisY + tick.Height)" class="@tick.Css">
                <title>@tick.Label</title>
            </line>
        }

        @if (ShowTopResidualWave)
        {
            <path d="@ResidualWavePath(TopWaveEndY())" class="scene-tension-wave">
                <title>top-side tension @Snapshot.SourceSite.Orthogonal.Residual.Normalize()</title>
            </path>
        }

        @if (ShowBottomResidualWave)
        {
            <path d="@ResidualWavePath(BottomWaveEndY())" class="scene-tension-wave">
                <title>bottom-side tension @Snapshot.SourceSite.Orthogonal.Residual.Normalize()</title>
            </path>
        }

        @if (TopChannels.Length == 1)
        {
            <line x1="@OriginX"
                  x2="@OriginX"
                  y1="@AxisY"
                  y2="@SingleTopY()"
                  class="@TopLineCss(TopChannels[0]) scene-drag-target"
                  marker-end="@TopMarker(TopChannels[0])"
                  @onpointerdown="BeginTopSignalDrag"
                  @onpointerdown:preventDefault
                  @onpointerdown:stopPropagation>
                <title>@TopChannels[0].Name @TopChannels[0].Value.Normalize()</title>
            </line>
        }
        else
        {
            @foreach (var branch in TopBranches())
            {
                <line x1="@branch.StartX"
                      y1="@branch.StartY"
                      x2="@branch.TipX"
                      y2="@branch.TipY"
                      class="@($"{branch.Css} scene-drag-target")"
                      marker-end="@branch.Marker"
                      @onpointerdown="@(e => BeginTopBranchDrag(branch.Index, e))"
                      @onpointerdown:preventDefault
                      @onpointerdown:stopPropagation>
                    <title>@branch.Label</title>
                </line>
            }
        }

        @if (BottomChannels.Length == 1)
        {
            <line x1="@OriginX"
                  x2="@OriginX"
                  y1="@AxisY"
                  y2="@SingleBottomY()"
                  class="scene-orthogonal-recessive scene-drag-target"
                  @onpointerdown="BeginBottomSignalDrag"
                  @onpointerdown:preventDefault
                  @onpointerdown:stopPropagation>
                <title>@BottomChannels[0].Name @BottomChannels[0].Value.Normalize()</title>
            </line>
            <circle cx="@OriginX"
                    cy="@SingleBottomY()"
                    r="4.2"
                    class="scene-orthogonal-recessive-node scene-drag-target"
                    @onpointerdown="BeginBottomSignalDrag"
                    @onpointerdown:preventDefault
                    @onpointerdown:stopPropagation>
                <title>@BottomChannels[0].Name @BottomChannels[0].Value.Normalize()</title>
            </circle>
        }
        else
        {
            @foreach (var branch in BottomBranches())
            {
                <line x1="@branch.StartX"
                      y1="@branch.StartY"
                      x2="@branch.TipX"
                      y2="@branch.TipY"
                      class="@($"{branch.Css} scene-drag-target")"
                      @onpointerdown="@(e => BeginBottomBranchDrag(branch.Index, e))"
                      @onpointerdown:preventDefault
                      @onpointerdown:stopPropagation>
                    <title>@branch.Label</title>
                </line>
                <circle cx="@branch.TipX"
                        cy="@branch.TipY"
                        r="4.2"
                        class="scene-branch-node-recessive scene-drag-target"
                        @onpointerdown="@(e => BeginBottomBranchDrag(branch.Index, e))"
                        @onpointerdown:preventDefault
                        @onpointerdown:stopPropagation>
                    <title>@branch.Label</title>
                </circle>
            }
        }

        @if (Snapshot.HasInverse)
        {
            <line x1="@OriginX"
                  x2="@RecessiveEndX()"
                  y1="@AxisY"
                  y2="@AxisY"
                  class="scene-aligned-recessive scene-drag-target"
                  @onpointerdown="BeginRecessiveSpanDrag"
                  @onpointerdown:preventDefault
                  @onpointerdown:stopPropagation>
                <title>recessive span -@Snapshot.Preset.RecessiveSpan.Raw</title>
            </line>
            <circle cx="@RecessiveEndX()"
                    cy="@AxisY"
                    r="4.2"
                    class="scene-aligned-recessive-node scene-drag-target"
                    @onpointerdown="BeginRecessiveSpanDrag"
                    @onpointerdown:preventDefault
                    @onpointerdown:stopPropagation>
                <title>recessive anchor @Snapshot.RecessiveAnchor.Raw</title>
            </circle>
        }

        <line x1="@OriginX"
              x2="@DominantEndX()"
              y1="@AxisY"
              y2="@AxisY"
              class="scene-aligned-dominant scene-drag-target"
              @onpointerdown="BeginDominantSpanDrag"
              @onpointerdown:preventDefault
              @onpointerdown:stopPropagation>
            <title>dominant span +@Snapshot.Preset.DominantSpan.Raw</title>
        </line>

        <polygon points="@DominantTipPoints(DominantEndX(), AxisY)"
                 class="scene-dominant-tip scene-drag-target"
                 @onpointerdown="BeginDominantSpanDrag"
                 @onpointerdown:preventDefault
                 @onpointerdown:stopPropagation>
            <title>dominant anchor @Snapshot.DominantAnchor.Raw</title>
        </polygon>
        <polygon points="@DominantTipInnerPoints(DominantEndX(), AxisY)"
                 class="scene-dominant-tip-inner scene-drag-target"
                 @onpointerdown="BeginDominantSpanDrag"
                 @onpointerdown:preventDefault
                 @onpointerdown:stopPropagation>
            <title>dominant anchor @Snapshot.DominantAnchor.Raw</title>
        </polygon>

        @foreach (var value in ValueGlyphs())
        {
            <line x1="@OriginX"
                  x2="@value.X"
                  y1="@value.Y"
                  y2="@value.Y"
                  class="@($"{value.LineCss} scene-drag-target")"
                  @onpointerdown="@(e => BeginValueDrag(value.Kind, e))"
                  @onpointerdown:preventDefault
                  @onpointerdown:stopPropagation>
                <title>@value.Label</title>
            </line>

            @if (value.Shape == "circle")
            {
                <circle cx="@value.X"
                        cy="@value.Y"
                        r="4.2"
                        class="@($"{value.NodeCss} scene-drag-target")"
                        @onpointerdown="@(e => BeginValueDrag(value.Kind, e))"
                        @onpointerdown:preventDefault
                        @onpointerdown:stopPropagation>
                    <title>@value.Label</title>
                </circle>
            }
            else
            {
                <polygon points="@ValueTrianglePoints(value.X, value.Y)"
                         class="@($"{value.NodeCss} scene-drag-target")"
                         @onpointerdown="@(e => BeginValueDrag(value.Kind, e))"
                         @onpointerdown:preventDefault
                         @onpointerdown:stopPropagation>
                    <title>@value.Label</title>
                </polygon>
            }
        }

        <rect x="@(OriginX - 4)"
              y="@(AxisY - 4)"
              width="8"
              height="8"
              rx="1"
              class="scene-origin-node scene-drag-target"
              @onpointerdown="BeginOriginDrag"
              @onpointerdown:preventDefault
              @onpointerdown:stopPropagation>
            <title>origin @Snapshot.Origin.Raw</title>
        </rect>
    </svg>

    <div class="scene-overlay">
        <div class="scene-reading-label scene-reading-label--complex" style="@Position(OriginX - 14d, 23)">
            <span class="scene-reading-term scene-reading-term--recessive">@($"{Snapshot.RecessiveReading.Normalize()}r")</span>
            <span class="scene-reading-plus"> + </span>
            <span class="scene-reading-term scene-reading-term--dominant">@($"{Snapshot.DominantReading.Normalize()}d")</span>
        </div>

        <div class="scene-reading-label scene-reading-label--approx" style="@Position(OriginX - 14d, 36)">
            @Snapshot.ApproximateReading
        </div>

        @foreach (var label in AxisLabels())
        {
            <div class="@label.Css" style="@Position(label.X, label.Y)">
                @label.Text
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NumericExplorerSnapshot Snapshot { get; set; } = default!;
    [Parameter] public EventCallback<long> OriginChanged { get; set; }
    [Parameter] public EventCallback<long> DominantSpanChanged { get; set; }
    [Parameter] public EventCallback<long> RecessiveSpanChanged { get; set; }
    [Parameter] public EventCallback<long> SingleValueOffsetChanged { get; set; }
    [Parameter] public EventCallback<long> DominantValueOffsetChanged { get; set; }
    [Parameter] public EventCallback<long> RecessiveValueOffsetChanged { get; set; }
    [Parameter] public EventCallback<long> TopSignalChanged { get; set; }
    [Parameter] public EventCallback<long> BottomSignalChanged { get; set; }
    [Parameter] public EventCallback<long> BottomSignal2Changed { get; set; }

    private const double AxisY = 126d;
    private const double BaseOriginX = 392d;
    private const double UnitPixels = 17d;
    private const double AxisStartX = 72d;
    private const double AxisEndX = 748d;
    private static readonly DragHandle None = new(string.Empty, -1);

    private NumericExplorerChannel[] TopChannels => Snapshot.Channels
        .Where(channel => channel.Value.Potential != Measure.Zero || channel.Value.Dominant != Measure.Zero)
        .Where(channel => !channel.Provenance.IsOther)
        .ToArray();

    private NumericExplorerChannel[] BottomChannels => Snapshot.Channels
        .Where(channel => channel.Value.Potential != Measure.Zero || channel.Value.Dominant != Measure.Zero)
        .Where(channel => channel.Provenance.IsOther)
        .ToArray();

    private bool ShowTopResidualWave => Snapshot.Preset.Controls.ShowResidual
        && Snapshot.Preset.Residual != Measure.Zero
        && TopChannels.Length > 0;

    private bool ShowBottomResidualWave => Snapshot.Preset.Controls.ShowResidual
        && Snapshot.Preset.Residual != Measure.Zero
        && BottomChannels.Length > 0;

    private DragHandle _activeDrag = None;
    private double _dragStartClientX;
    private double _dragStartClientY;
    private long _dragStartValue;

    private double OriginX => ClampX(BaseOriginX + (Snapshot.Origin.Raw * UnitPixels));

    private double DominantEndX() => ClampX(OriginX + (Snapshot.Preset.DominantSpan.Raw * UnitPixels));

    private double RecessiveEndX() => ClampX(OriginX - (Snapshot.Preset.RecessiveSpan.Raw * UnitPixels));

    private IEnumerable<TickGlyph> AxisTicks()
    {
        var positive = (long)Math.Floor((AxisEndX - OriginX) / UnitPixels);
        for (var index = 1L; index <= positive; index++)
        {
            yield return new TickGlyph(
                OriginX + (index * UnitPixels),
                IsStrong(index, Snapshot.Preset.DominantSpan.Raw) ? 5.3d : 2.6d,
                IsStrong(index, Snapshot.Preset.DominantSpan.Raw) ? "scene-tick-dominant-strong" : "scene-tick-dominant-soft",
                $"+ tick {index}");
        }

        var negative = (long)Math.Floor((OriginX - AxisStartX) / UnitPixels);
        for (var index = 1L; index <= negative; index++)
        {
            yield return new TickGlyph(
                OriginX - (index * UnitPixels),
                IsStrong(index, Snapshot.Preset.RecessiveSpan.Raw) ? 5.3d : 2.6d,
                IsStrong(index, Snapshot.Preset.RecessiveSpan.Raw) ? "scene-tick-recessive-strong" : "scene-tick-recessive-soft",
                $"- tick {index}");
        }
    }

    private IEnumerable<AxisLabelGlyph> AxisLabels()
    {
        if (Snapshot.Preset.DominantSpan.Raw > 0)
        {
            var positive = (long)Math.Floor((AxisEndX - OriginX) / UnitPixels);
            for (var index = Snapshot.Preset.DominantSpan.Raw; index <= positive; index += Snapshot.Preset.DominantSpan.Raw)
            {
                yield return new AxisLabelGlyph(
                    OriginX + (index * UnitPixels),
                    AxisY + 13d,
                    (Snapshot.Origin.Raw + index).ToString(),
                    "scene-axis-label scene-axis-label--dominant");
            }
        }

        if (Snapshot.Preset.RecessiveSpan.Raw > 0)
        {
            var negative = (long)Math.Floor((OriginX - AxisStartX) / UnitPixels);
            for (var index = Snapshot.Preset.RecessiveSpan.Raw; index <= negative; index += Snapshot.Preset.RecessiveSpan.Raw)
            {
                yield return new AxisLabelGlyph(
                    OriginX - (index * UnitPixels),
                    AxisY - 14d,
                    (Snapshot.Origin.Raw - index).ToString(),
                    "scene-axis-label scene-axis-label--recessive");
            }
        }
    }

    private IEnumerable<ValueGlyph> ValueGlyphs()
    {
        if (Snapshot.Preset.Controls.ShowDominantValue && Snapshot.Preset.DominantValueOffset != Measure.Zero)
        {
            yield return new ValueGlyph(
                ClampX(OriginX + (Snapshot.Preset.DominantValueOffset.Raw * UnitPixels)),
                AxisY - 14d,
                "scene-value-line scene-value-line--dominant",
                "scene-value-node--dominant",
                "triangle",
                "dominant-value",
                $"dominant value {Snapshot.DominantReading.Normalize()}");
        }

        if (Snapshot.Preset.Controls.ShowRecessiveValue && Snapshot.Preset.RecessiveValueOffset != Measure.Zero)
        {
            yield return new ValueGlyph(
                ClampX(OriginX - (Snapshot.Preset.RecessiveValueOffset.Raw * UnitPixels)),
                AxisY + 14d,
                "scene-value-line scene-value-line--recessive",
                "scene-value-node--recessive",
                "circle",
                "recessive-value",
                $"recessive value {Snapshot.RecessiveReading.Normalize()}");
        }

        if (Snapshot.Preset.Controls.ShowSingleValue && !Snapshot.IsHiddenOnHalfLine)
        {
            var x = ClampX(OriginX + (Snapshot.Preset.SingleValueOffset.Raw * UnitPixels));
            if (Snapshot.Preset.SingleValueOffset.Raw >= 0)
            {
                yield return new ValueGlyph(
                    x,
                    AxisY - 14d,
                    "scene-value-line scene-value-line--dominant",
                    "scene-value-node--dominant",
                    "triangle",
                    "single-value",
                    $"dominant value {Snapshot.DominantReading.Normalize()}");
            }
            else
            {
                yield return new ValueGlyph(
                    x,
                    AxisY + 14d,
                    "scene-value-line scene-value-line--recessive",
                    "scene-value-node--recessive",
                    "circle",
                    "single-value",
                    $"recessive value {Snapshot.RecessiveReading.Normalize()}");
            }
        }

        if (Snapshot.IsHiddenOnHalfLine)
        {
            yield return new ValueGlyph(
                ClampX(OriginX - (Snapshot.Preset.SingleValueOffset.Absolute.Raw * UnitPixels)),
                AxisY + 24d,
                "scene-hidden-tension",
                "scene-hidden-tension-node",
                "circle",
                "single-value",
                $"hidden side tension {Snapshot.HiddenTension.Normalize()}");
        }
    }

    private double ChannelHeight(NumericExplorerChannel channel) => Math.Max(0d, channel.Value.Potential.Raw * UnitPixels);

    private double SingleTopY() => AxisY - ChannelHeight(TopChannels[0]);

    private double SingleBottomY() => AxisY + ChannelHeight(BottomChannels[0]);

    private double TopWaveEndY()
    {
        if (TopChannels.Length == 0)
        {
            return AxisY;
        }

        return TopChannels.Length == 1
            ? SingleTopY() + 10d
            : TopChannels.Min(channel => AxisY - ChannelHeight(channel)) + 10d;
    }

    private double BottomWaveEndY()
    {
        if (BottomChannels.Length == 0)
        {
            return AxisY;
        }

        return BottomChannels.Length == 1
            ? SingleBottomY() - 10d
            : BottomChannels.Max(channel => AxisY + ChannelHeight(channel)) - 10d;
    }

    private string TopLineCss(NumericExplorerChannel channel) => channel.Provenance.IsShared
        ? "scene-branch-shared"
        : "scene-orthogonal-dominant";

    private string TopMarker(NumericExplorerChannel channel) => channel.Provenance.IsShared
        ? "url(#arrowShared)"
        : "url(#arrowOrthogonal)";

    private string ResidualWavePath(double endY)
    {
        var distance = Math.Abs(endY - AxisY);
        if (distance < 1d)
        {
            return $"M {OriginX},{AxisY}";
        }

        var direction = Math.Sign(endY - AxisY);
        var amplitude = 15d + Math.Min(8d, Snapshot.Preset.Residual.Raw * 0.65d);
        var lanes = Math.Max(4, (int)Math.Ceiling(distance / 9d));
        var step = distance / lanes;
        var radius = step / 2d;
        var currentY = AxisY;
        var currentSideRight = direction < 0;
        var startX = currentSideRight ? OriginX + amplitude : OriginX - amplitude;
        var parts = new List<string>
        {
            $"M {OriginX},{AxisY}",
            $"L {startX},{AxisY}"
        };

        for (var lane = 0; lane < lanes; lane++)
        {
            var nextY = AxisY + (direction * step * (lane + 1));
            var sideX = currentSideRight ? OriginX + amplitude : OriginX - amplitude;
            var sweep = currentSideRight ? (direction < 0 ? 0 : 1) : (direction < 0 ? 1 : 0);
            parts.Add($"A {radius:F3},{radius:F3} 0 0 {sweep} {sideX},{nextY:F3}");

            var targetX = lane == lanes - 1
                ? OriginX
                : currentSideRight
                    ? OriginX - amplitude
                    : OriginX + amplitude;

            parts.Add($"L {targetX},{nextY:F3}");
            currentSideRight = !currentSideRight;
            currentY = nextY;
        }

        if (Math.Abs(currentY - endY) > 0.01d)
        {
            parts.Add($"L {OriginX},{endY:F3}");
        }

        return string.Join(' ', parts);
    }

    private IEnumerable<BranchGlyph> TopBranches() => CreateBranches(TopChannels, false);

    private IEnumerable<BranchGlyph> BottomBranches() => CreateBranches(BottomChannels, true);

    private IEnumerable<BranchGlyph> CreateBranches(IReadOnlyList<NumericExplorerChannel> channels, bool recessive)
    {
        if (channels.Count <= 1)
        {
            yield break;
        }

        for (var index = 0; index < channels.Count; index++)
        {
            var channel = channels[index];
            var spread = (index - ((channels.Count - 1) / 2d)) * 54d;
            var tipX = OriginX + spread;
            var tipY = recessive ? AxisY + ChannelHeight(channel) : AxisY - ChannelHeight(channel);

            yield return new BranchGlyph(
                index,
                OriginX,
                AxisY,
                tipX,
                tipY,
                $"{channel.Name} {channel.Value.Normalize()}",
                recessive
                    ? "scene-branch-recessive"
                    : channel.Provenance.IsShared
                        ? "scene-branch-shared"
                        : "scene-branch-dominant",
                recessive ? null : channel.Provenance.IsShared ? "url(#arrowShared)" : "url(#arrowOrthogonal)");
        }
    }

    private void BeginOriginDrag(PointerEventArgs args) => BeginDrag("origin", Snapshot.Preset.Origin.Raw, args);

    private void BeginDominantSpanDrag(PointerEventArgs args) => BeginDrag("dominant-span", Snapshot.Preset.DominantSpan.Raw, args);

    private void BeginRecessiveSpanDrag(PointerEventArgs args) => BeginDrag("recessive-span", Snapshot.Preset.RecessiveSpan.Raw, args);

    private void BeginValueDrag(string kind, PointerEventArgs args)
    {
        var start = kind switch
        {
            "dominant-value" => Snapshot.Preset.DominantValueOffset.Raw,
            "recessive-value" => Snapshot.Preset.RecessiveValueOffset.Raw,
            _ => Snapshot.Preset.SingleValueOffset.Raw
        };

        BeginDrag(kind, start, args);
    }

    private void BeginTopSignalDrag(PointerEventArgs args) => BeginDrag("top-signal", Snapshot.Preset.TopSignal.Raw, args);

    private void BeginBottomSignalDrag(PointerEventArgs args) => BeginDrag("bottom-signal", Snapshot.Preset.BottomSignal.Raw, args);

    private void BeginTopBranchDrag(int index, PointerEventArgs args) =>
        BeginDrag(index == 0 ? "top-signal" : "top-shared", Snapshot.Preset.TopSignal.Raw, args);

    private void BeginBottomBranchDrag(int index, PointerEventArgs args) =>
        BeginDrag(index == 0 ? "bottom-signal" : "bottom-signal-2", index == 0 ? Snapshot.Preset.BottomSignal.Raw : Snapshot.Preset.BottomSignal2.Raw, args);

    private void BeginDrag(string kind, long currentValue, PointerEventArgs args)
    {
        _activeDrag = new DragHandle(kind, 0);
        _dragStartClientX = args.ClientX;
        _dragStartClientY = args.ClientY;
        _dragStartValue = currentValue;
    }

    private async Task OnPointerMove(PointerEventArgs args)
    {
        if (_activeDrag == None)
        {
            return;
        }

        switch (_activeDrag.Kind)
        {
            case "origin":
            {
                var next = _dragStartValue + DeltaUnitsX(args.ClientX);
                await OriginChanged.InvokeAsync(next);
                break;
            }
            case "dominant-span":
            {
                var span = Math.Max(1L, _dragStartValue + DeltaUnitsX(args.ClientX));
                if (Snapshot.Preset.Controls.ShowFusedSpan)
                {
                    await DominantSpanChanged.InvokeAsync(span);
                    await RecessiveSpanChanged.InvokeAsync(span);
                }
                else
                {
                    await DominantSpanChanged.InvokeAsync(span);
                }

                break;
            }
            case "recessive-span":
            {
                var span = Math.Max(0L, _dragStartValue - DeltaUnitsX(args.ClientX));
                if (Snapshot.Preset.Controls.ShowFusedSpan)
                {
                    span = Math.Max(1L, span);
                    await DominantSpanChanged.InvokeAsync(span);
                    await RecessiveSpanChanged.InvokeAsync(span);
                }
                else
                {
                    await RecessiveSpanChanged.InvokeAsync(span);
                }

                break;
            }
            case "single-value":
                await SingleValueOffsetChanged.InvokeAsync(_dragStartValue + DeltaUnitsX(args.ClientX));
                break;
            case "dominant-value":
                await DominantValueOffsetChanged.InvokeAsync(ClampPairValue(_dragStartValue + DeltaUnitsX(args.ClientX)));
                break;
            case "recessive-value":
                await RecessiveValueOffsetChanged.InvokeAsync(ClampPairValue(_dragStartValue - DeltaUnitsX(args.ClientX)));
                break;
            case "top-signal":
            case "top-shared":
                await TopSignalChanged.InvokeAsync(Math.Max(0L, _dragStartValue - DeltaUnitsY(args.ClientY)));
                break;
            case "bottom-signal":
                await BottomSignalChanged.InvokeAsync(Math.Max(0L, _dragStartValue + DeltaUnitsY(args.ClientY)));
                break;
            case "bottom-signal-2":
                await BottomSignal2Changed.InvokeAsync(Math.Max(0L, _dragStartValue + DeltaUnitsY(args.ClientY)));
                break;
        }
    }

    private void EndDrag(PointerEventArgs args) => _activeDrag = None;

    private int DeltaUnitsX(double currentClientX) => (int)Math.Round((currentClientX - _dragStartClientX) / UnitPixels, MidpointRounding.AwayFromZero);

    private int DeltaUnitsY(double currentClientY) => (int)Math.Round((currentClientY - _dragStartClientY) / UnitPixels, MidpointRounding.AwayFromZero);

    private long ClampPairValue(long value) => Snapshot.Preset.FuseAligned ? value : Math.Max(0L, value);

    private static bool IsStrong(long index, long span) => span > 0 && index % span == 0;

    private static double ClampX(double x) => Math.Max(AxisStartX + 6d, Math.Min(AxisEndX - 6d, x));

    private static string Position(double x, double y) => $"left:{(x / 820d) * 100:F3}%;top:{(y / 248d) * 100:F3}%;";

    private static string DominantTipPoints(double x, double y) => $"{x + 1.8},{y} {x - 9.4},{y - 6} {x - 9.4},{y + 6}";

    private static string DominantTipInnerPoints(double x, double y) => $"{x - 1.2},{y} {x - 6.8},{y - 3.2} {x - 6.8},{y + 3.2}";

    private static string ValueTrianglePoints(double x, double y) => $"{x + 1.5},{y} {x - 5.9},{y - 4.0} {x - 5.9},{y + 4.0}";

    private readonly record struct TickGlyph(double X, double Height, string Css, string Label);

    private readonly record struct AxisLabelGlyph(double X, double Y, string Text, string Css);

    private readonly record struct BranchGlyph(
        int Index,
        double StartX,
        double StartY,
        double TipX,
        double TipY,

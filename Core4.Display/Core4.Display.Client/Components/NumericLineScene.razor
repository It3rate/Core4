@using Core4.Examples
@using Core4.Numerics

<svg class="numeric-scene" viewBox="0 0 820 320" role="img" aria-label="Core4 numeric explorer scene">
    <defs>
        <linearGradient id="dominantGlow" x1="0%" x2="100%" y1="0%" y2="0%">
            <stop offset="0%" stop-color="var(--tone-dominant-soft)" />
            <stop offset="100%" stop-color="var(--tone-dominant)" />
        </linearGradient>
        <linearGradient id="recessiveGlow" x1="0%" x2="100%" y1="0%" y2="0%">
            <stop offset="0%" stop-color="var(--tone-recessive)" />
            <stop offset="100%" stop-color="var(--tone-recessive-soft)" />
        </linearGradient>
        <marker id="arrowDominant" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="10" markerHeight="10" orient="auto">
            <path d="M0 0 L12 6 L0 12 L3.2 6 Z" fill="var(--tone-dominant)" />
        </marker>
        <marker id="arrowOrthogonal" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="10" markerHeight="10" orient="auto">
            <path d="M0 0 L12 6 L0 12 L3.2 6 Z" fill="var(--tone-orthogonal)" />
        </marker>
        <marker id="arrowShared" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="10" markerHeight="10" orient="auto">
            <path d="M0 0 L12 6 L0 12 L3.2 6 Z" fill="var(--tone-gold)" />
        </marker>
    </defs>

    <rect x="0" y="0" width="820" height="320" rx="24" class="scene-surface" />

    @if (Snapshot.IsHiddenOnHalfLine)
    {
        <rect x="40" y="58" width="@(X(Snapshot.Origin) - 40)" height="204" class="scene-hidden" rx="18">
            <title>inverse side unrevealed</title>
        </rect>
    }

    @foreach (var tick in Ticks())
    {
        <line x1="@X(tick)" x2="@X(tick)" y1="86" y2="246" class="scene-grid">
            <title>tick @tick.Raw</title>
        </line>
    }

    <line x1="40" x2="780" y1="@AxisY" y2="@AxisY" class="scene-axis" />

    @foreach (var branch in Branches())
    {
        <line x1="@branch.StartX"
              y1="@branch.StartY"
              x2="@branch.TipX"
              y2="@branch.TipY"
              class="@branch.Css"
              style="@($"stroke-width:{branch.Width};")"
              marker-end="@branch.Marker">
            <title>@branch.Label</title>
        </line>

        @if (branch.HasCircle)
        {
            <circle cx="@branch.TipX" cy="@branch.TipY" r="8" class="@branch.NodeCss">
                <title>@branch.Label</title>
            </circle>
        }
    }

    <line x1="@OriginX()" x2="@X(Snapshot.DominantAnchor)" y1="@AxisY" y2="@AxisY" class="scene-dominant" style="@($"stroke-width:{Stroke(Snapshot.Preset.DominantSpan)};")" marker-end="url(#arrowDominant)">
        <title>dominant span +@Snapshot.Preset.DominantSpan.Raw</title>
    </line>

    @if (Snapshot.HasInverse)
    {
        <line x1="@OriginX()" x2="@X(Snapshot.RecessiveAnchor)" y1="@AxisY" y2="@AxisY" class="scene-recessive" style="@($"stroke-width:{Stroke(Snapshot.Preset.RecessiveSpan)};")">
            <title>recessive span -@Snapshot.Preset.RecessiveSpan.Raw</title>
        </line>
        <circle cx="@X(Snapshot.RecessiveAnchor)" cy="@AxisY" r="9" class="scene-recessive-node">
            <title>recessive anchor @Snapshot.RecessiveAnchor.Raw</title>
        </circle>
    }

    @if (Snapshot.IsHiddenOnHalfLine)
    {
        <line x1="@OriginX()" x2="@HiddenValueX()" y1="@AxisY" y2="@(AxisY + 52)" class="scene-tension">
            <title>hidden side tension @Snapshot.HiddenTension.Normalize()</title>
        </line>
        <circle cx="@HiddenValueX()" cy="@(AxisY + 52)" r="8" class="scene-tension-node">
            <title>hidden side tension @Snapshot.HiddenTension.Normalize()</title>
        </circle>
    }
    else
    {
        <line x1="@OriginX()" x2="@X(Snapshot.Value)" y1="@(AxisY - 30)" y2="@(AxisY - 30)" class="scene-value-line">
            <title>value @Snapshot.Value.Raw</title>
        </line>
        <circle cx="@X(Snapshot.Value)" cy="@(AxisY - 30)" r="9" class="scene-value-node">
            <title>value @Snapshot.Value.Raw</title>
        </circle>
    }

    <rect x="@(OriginX() - 9)" y="@(AxisY - 9)" width="18" height="18" rx="2" class="scene-origin-node">
        <title>origin @Snapshot.Origin.Raw</title>
    </rect>
</svg>

@code {
    [Parameter, EditorRequired] public NumericExplorerSnapshot Snapshot { get; set; } = default!;

    private const double AxisY = 180d;

    private double OriginX() => X(Snapshot.Origin);

    private double X(Measure value)
    {
        var min = Snapshot.VisualMin.Raw;
        var max = Snapshot.VisualMax.Raw;
        var width = Math.Max(1d, max - min);
        return 40d + ((value.Raw - min) / width) * 740d;
    }

    private double HiddenValueX()
    {
        var origin = OriginX();
        var left = X(Snapshot.VisualMin);
        return left + ((origin - left) * 0.42d);
    }

    private double Stroke(Measure span) => 4d + Math.Min(12d, span.Raw * 0.38d);

    private IEnumerable<Measure> Ticks()
    {
        var min = Snapshot.VisualMin.Raw;
        var max = Snapshot.VisualMax.Raw;
        var steps = 8L;
        var width = Math.Max(1L, max - min);

        for (var index = 0L; index <= steps; index++)
        {
            yield return new Measure(min + ((width * index) / steps));
        }
    }

    private IEnumerable<BranchGlyph> Branches()
    {
        var top = new List<NumericExplorerChannel>();
        var bottom = new List<NumericExplorerChannel>();

        foreach (var channel in Snapshot.Channels)
        {
            if (channel.Value.Potential == Measure.Zero && channel.Value.Dominant == Measure.Zero)
            {
                continue;
            }

            if (channel.Provenance.IsOther)
            {
                bottom.Add(channel);
            }
            else
            {
                top.Add(channel);
            }
        }

        foreach (var branch in CreateBranches(top, false))
        {
            yield return branch;
        }

        foreach (var branch in CreateBranches(bottom, true))
        {
            yield return branch;
        }

        if (Snapshot.Preset.Residual != Measure.Zero)
        {
            yield return new BranchGlyph(
                OriginX(),
                AxisY,
                OriginX(),
                AxisY - (44d + Math.Min(52d, Snapshot.Preset.Residual.Raw * 4d)),
                $"residual {Snapshot.SourceSite.Orthogonal.Residual.Normalize()}",
                "scene-branch-residual",
                string.Empty,
                2.5d + Math.Min(5d, Snapshot.Preset.Residual.Raw * 0.35d),
                null,
                false);
        }
    }

    private IEnumerable<BranchGlyph> CreateBranches(IReadOnlyList<NumericExplorerChannel> channels, bool recessive)
    {
        for (var index = 0; index < channels.Count; index++)
        {
            var channel = channels[index];
            var spread = (index - ((channels.Count - 1) / 2d)) * 46d;
            var height = 70d + Math.Min(42d, channel.Value.Potential.Raw * 4d);
            var label = $"{channel.Name} {channel.Value.Normalize()}";
            var isShared = channel.Provenance.IsShared;

            yield return new BranchGlyph(
                OriginX(),
                AxisY,
                OriginX() + spread,
                recessive ? AxisY + height : AxisY - height,
                label,
                isShared ? "scene-branch-shared" : "scene-branch-other",
                isShared ? "scene-branch-node-shared" : "scene-branch-node-other",
                2.5d + Math.Min(6d, channel.Value.Potential.Raw * 0.45d),
                recessive ? null : isShared ? "url(#arrowShared)" : "url(#arrowOrthogonal)",
                recessive);
        }
    }

    private readonly record struct BranchGlyph(
        double StartX,
        double StartY,
        double TipX,
        double TipY,
        string Label,
        string Css,
        string NodeCss,
        double Width,
        string? Marker,
        bool HasCircle);
}

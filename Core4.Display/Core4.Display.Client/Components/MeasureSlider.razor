<div class="measure-slider @(HollowThumb ? "measure-slider--hollow" : "measure-slider--solid") @(IsSignedRange ? "measure-slider--signed" : string.Empty)"
     style="@($"--tone:{Tone};--zero-pos:{ZeroPosition:0.###}%;")">
    <div class="measure-slider__header">
        <label>@Label</label>
        <span>@Value</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <p class="measure-slider__caption">@Caption</p>
    }
    <div class="measure-slider__inputs">
        <input type="range"
               min="@Min"
               max="@Max"
               step="@Step"
               value="@Value"
               @oninput="OnChanged" />
        <input type="number"
               min="@Min"
               max="@Max"
               step="@Step"
               value="@Value"
               @oninput="OnChanged" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string Caption { get; set; } = string.Empty;
    [Parameter] public string Tone { get; set; } = "var(--tone-ink)";
    [Parameter] public long Value { get; set; }
    [Parameter] public long Min { get; set; } = -20;
    [Parameter] public long Max { get; set; } = 20;
    [Parameter] public long Step { get; set; } = 1;
    [Parameter] public bool HollowThumb { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }

    private bool IsSignedRange => Min < 0 && Max > 0;

    private double ZeroPosition => IsSignedRange
        ? ((double)(0 - Min) / (Max - Min)) * 100d
        : 0d;

    private async Task OnChanged(ChangeEventArgs args)
    {
        if (long.TryParse(args.Value?.ToString(), out var next))
        {
            await ValueChanged.InvokeAsync(next);
        }
    }
}

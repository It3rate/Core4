<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);GOJO_GEAR_BROWSER</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gojo\Gojo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Gojo.GearDemo\GearDemoApp.cs" Link="GearDemoApp.cs" />
    <Compile Include="..\Gojo.GearDemo\GearDemoCanvas.cs" Link="GearDemoCanvas.cs" />
    <Compile Include="..\Gojo.GearDemo\GearDemoWindow.cs" Link="GearDemoWindow.cs" />
    <Compile Include="..\Gojo.GearDemo\Model\**\*.cs" Link="Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Gojo.GearDemo\Rendering\**\*.cs" Link="Rendering\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
